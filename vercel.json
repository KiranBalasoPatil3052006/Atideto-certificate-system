{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://atideto-backend-system.vercel.app/api/:path*" },
    { "source": "/verify/:path*", "destination": "/verify.html" },
    { "source": "/verify", "destination": "/verify.html" },
    { "source": "/preview/:path*", "destination": "/preview.html" },
    { "source": "/preview", "destination": "/preview.html" },
    { "source": "/offer-letter/:path*", "destination": "/offer-letter-preview.html" },
    { "source": "/offer-letter", "destination": "/offer-letter-preview.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
